-- Blox Fruits: Auto Chest (Cloud Hub - Fixed Edition)
-- ระบบ: บิน BodyVelocity + ESP สีดำ + UI ครบ + แก้บินค้าง 100%
-- ================================================

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

_G.AutoChest = false
_G.ChestESP = false
_G.FlySpeed = 280

-- ระบบบิน (BodyVelocity) แบบเคลียร์ค่าปลอดภัย
local bv, bg
local function startFlight()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        if not bv then
            bv = Instance.new("BodyVelocity", root)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
        end
        if not bg then
            bg = Instance.new("BodyGyro", root)
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.CFrame = root.CFrame
        end
    end
end

local function stopFlight()
    if bv then bv:Destroy(); bv = nil end
    if bg then bg:Destroy(); bg = nil end
end

-- ระบบ Anti-Seat & NoClip (ทำงานเฉพาะตอนเปิด Auto Chest เท่านั้น)
RunService.Stepped:Connect(function()
    if LocalPlayer.Character and _G.AutoChest then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        
        -- นั่งเก้าอี้กระโดดลุกทันที
        if hum and hum.Sit then
            hum.Sit = false
            hum.Jump = true
        end
        
        -- NoClip ทะลุกำแพงขณะบิน
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then 
                part.CanCollide = false 
            end
        end
    end
end)

-- ฟังก์ชันดึงรายการกล่องทั้งหมด และเรียงลำดับตามระยะทางที่ใกล้ที่สุด
local function getChestsSorted()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    
    local chests = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
            local dist = (v.Position - root.Position).Magnitude
            table.insert(chests, {part = v, distance = dist})
        end
    end
    
    table.sort(chests, function(a, b)
        return a.distance < b.distance
    end)
    
    return chests
end

-- ลูปการเก็บกล่องอัจฉริยะ (แก้บินค้าง)
task.spawn(function()
    while true do
        task.wait(0.05)
        if _G.AutoChest then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if root then
                startFlight()
                
                local chestList = getChestsSorted()
                if #chestList > 0 then
                    local targetData = chestList[1]
                    local targetChest = targetData.part
                    
                    local startTime = tick()
                    while _G.AutoChest and targetChest and targetChest.Parent and targetChest:FindFirstChild("TouchInterest") do
                        task.wait()
                        
                        -- กันค้าง: ถ้านานเกิน 8 วินาทีแล้วไม่ถึงกล่อง ให้เปลี่ยนไปหากล่องอื่นทันที
                        if tick() - startTime > 8 then break end
                        
                        root = char:FindFirstChild("HumanoidRootPart")
                        if not root then break end
                        
                        local currentDist = (targetChest.Position - root.Position).Magnitude
                        
                        -- บินไปหาตำแหน่งกล่อง
                        if bv and bg then
                            local direction = (targetChest.Position - root.Position).Unit
                            bv.Velocity = direction * _G.FlySpeed
                            bg.CFrame = CFrame.new(root.Position, targetChest.Position)
                        end
                        
                        -- เมื่อถึงระยะเก็บกล่อง (ระยะ 15 studs)
                        if currentDist <= 15 then
                            if bv then bv.Velocity = Vector3.new(0, 0, 0) end
                            firetouchinterest(root, targetChest, 0)
                            task.wait(0.05)
                            firetouchinterest(root, targetChest, 1)
                            task.wait(0.1)
                            break
                        end
                    end
                else
                    -- ถ้าไม่มีกล่อง หยุดบินลอยตัวนิ่งๆ
                    if bv then bv.Velocity = Vector3.new(0, 0, 0) end
                end
            end
        else
            stopFlight()
        end
    end
end)

