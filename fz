-- ระบบ ESP สีดำ อัจฉริยะ
task.spawn(function()
    while true do
        task.wait(0.2)
        if _G.ChestESP then
            -- 1. กวาดลบ ESP เก่าที่กล่องถูกเก็บไปแล้วออก
            for _, esp in pairs(workspace:GetDescendants()) do
                if esp.Name == "ChestESP" and esp:IsA("BillboardGui") then
                    local parentPart = esp.Parent
                    if not parentPart or not parentPart.Parent or not parentPart:FindFirstChild("TouchInterest") then
                        esp:Destroy()
                    end
                end
            end

            -- 2. สร้าง ESP ให้กับกล่องเกิดใหม่
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") and not v:FindFirstChild("ChestESP") then
                    local bill = Instance.new("BillboardGui", v)
                    bill.Name = "ChestESP"
                    bill.AlwaysOnTop = true
                    bill.Size = UDim2.new(0, 100, 0, 30)
                    
                    local label = Instance.new("TextLabel", bill)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = Color3.fromRGB(0, 0, 0)
                    label.TextStrokeColor3 = Color3.fromRGB(255, 255, 255)
                    label.TextStrokeTransparency = 0
                    label.Text = v.Name
                end
            end
        end
    end
end)
